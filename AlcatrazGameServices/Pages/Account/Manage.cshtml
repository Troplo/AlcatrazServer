@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Alcatraz.GameServices.Pages.Account.ManageModel
@{
    ViewBag.Title = "Manage Account";
}

<div class="row">
    <div class="col-md-4">
        <h3>Manage Account - <b>@Model.CurrentUserName</b></h3>
        <form method="post" asp-route="SignUp">
            <div class="form-group mb-3">
                <label class="control-label">Login</label> <input class="form-control" asp-for="@Model.EditModel.Email" value='@Model.EditModel.Email' />
                <label class="control-label">In-game Nickname</label> <input class="form-control" asp-for="@Model.EditModel.PlayerNickName" value='@Model.EditModel.PlayerNickName' />

                <span class="text-danger">@Model.ErrorMessage</span>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">New Password</label> <input class="form-control" type="password" asp-for="@Model.NewPassword" />
                <label class="control-label">Retype New Password</label> <input class="form-control" type="password" asp-for="@Model.NewPasswordRetype" />

                <span class="text-danger">@Model.PasswordErrorMessage</span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>
    </div>
    <div class="col-md-4">
        <h3>In-Game Login PIN</h3>
        <p>Use a PIN to login to your account inside the game.</p>
        <form method="post" asp-page-handler="GeneratePin">
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-secondary">Generate Login PIN</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.GeneratedPin))
        {
            <div class="alert alert-success mt-3">
                <strong>Your PIN:</strong> <span style="font-family: monospace; font-size: 1.2em;">@Model.GeneratedPin</span>
                <p class="mb-0 mt-2 text-muted">This PIN expires in 30 minutes.</p>
            </div>
        }
    </div>
</div>